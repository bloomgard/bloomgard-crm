# -------------------------------------------------------------
# Bloomgard CRM - environment variables
# Copy to web/.env.local (gitignored) and fill in. Never commit real values.
# On Vercel set the same names under Project > Settings > Environment Variables.
# -------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (OpenRouter) and optional voice agent (Bland)
OPENROUTER_API_KEY=
BLAND_API_KEY=

# Email (Resend) - all inbound and outbound mail flows through Resend
RESEND_API_KEY=
# Optional, sandbox testing only: when a sender domain is not verified, deliver
# to these addresses via onboarding@resend.dev instead of failing. Leave unset in production.
RESEND_FALLBACK_TO=

# -------------------------------------------------------------
# End-to-end tests (Playwright) - see web/e2e/README.md
# -------------------------------------------------------------
# Account used for UI login and to resolve the workspace under test
E2E_EMAIL=
E2E_PASSWORD=
# Where the app is running (local build: http://localhost:3011)
E2E_BASE_URL=
# Only for protected Vercel preview URLs
VERCEL_PROTECTION_BYPASS=
